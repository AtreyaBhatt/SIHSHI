{
  "name": "athena-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-capture.mjs",
    "test:capture": "node scripts/test-capture.mjs",
    "test:dom-heuristics": "node scripts/test-dom-heuristics.mjs",
    "test:executor": "node scripts/test-executor.mjs",
    "test:redaction": "node scripts/test-redaction.mjs",
    "test:provider": "node scripts/test-provider.mjs",
    "test:reasoning": "node scripts/test-reasoning.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:c": "node scripts/test-e2e.mjs ../eval/fixtures/kyc-form.html",
    "test:e2e:blindfill": "node scripts/test-e2e.mjs ../eval/fixtures/blindfill.html",
    "test:e2e:portal": "node scripts/test-e2e.mjs ../eval/fixtures/application-portal.html",
    "test:loop": "node scripts/test-loop.mjs",
    "test:vault": "node scripts/test-vault.mjs",
    "test:faces": "node scripts/test-faces.mjs",
    "fetch:model": "curl -sSL --create-dirs -o models/version-RFB-320.onnx https://github.com/onnx/models/raw/main/validated/vision/body_analysis/ultraface/models/version-RFB-320.onnx",
    "fetch:demo-faces": "curl -sSL --create-dirs -o ../eval/fixtures/assets/faces-2.jpg https://raw.githubusercontent.com/onnx/models/main/validated/vision/body_analysis/ultraface/dependencies/2.jpg",
    "test:scenario-b": "node scripts/test-scenario-b.mjs",
    "test:delta": "node scripts/test-delta.mjs",
    "preview:viewer": "node scripts/preview-viewer.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0"
  }
}
